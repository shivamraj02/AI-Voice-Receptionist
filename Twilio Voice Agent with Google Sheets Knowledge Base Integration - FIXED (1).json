    {
      "parameters": {
        "jsCode": "// Parse OpenAI response\nlet aiResponse;\ntry {\n  const content = $json.message?.content || $json.choices?.[0]?.message?.content || \"\";\n  aiResponse = JSON.parse(content);\n} catch {\n  aiResponse = {\n    reply: \"I can help you with your immigration needs. What would you like to know about?\",\n    intent: \"GENERAL_INFO\",\n    extractedInfo: {}\n  };\n}\n\n// Get previous state\nconst prevState = $node[\"Code - Prepare Call State\"].json;\n\n// Update transcript\nconst transcript = prevState.transcript || [];\ntranscript.push({\n  role: \"user\",\n  content: prevState.speech,\n  ts: new Date().toISOString()\n});\ntranscript.push({\n  role: \"assistant\",\n  content: aiResponse.reply,\n  ts: new Date().toISOString(),\n  intent: aiResponse.intent\n});\n\n// Keep last 10 turns\nconst trimmedTranscript = transcript.slice(-10);\n\nreturn [{\n  json: {\n    ...prevState,\n    lastAgentReply: aiResponse.reply,\n    intent: aiResponse.intent,\n    transcriptJson: JSON.stringify(trimmedTranscript),\n    name: aiResponse.extractedInfo?.name || prevState.name || \"\",\n    email: aiResponse.extractedInfo?.email || prevState.email || \"\",\n    topic: aiResponse.extractedInfo?.topic || prevState.topic || \"\",\n    urgency: aiResponse.extractedInfo?.urgency || prevState.urgency || \"\"\n  }\n}];"
      },
