    {
      "parameters": {
        "jsCode": "const callSid = $node[\"Code - Normalize Twilio Payload\"].json.callSid;\nconst rows = $items(\"Google Sheets - Read Leads\");\n\nlet found = null;\nlet row_number = null;\n\nfor (const item of rows) {\n  if (item.json.callSid === callSid) {\n    found = item.json;\n    const rn = item.rowNumber ?? item.rowIndex ?? item.json.rowNumber ?? item.row_number ?? item.json.row_number ?? item.json.rowIndex ?? item.json.__rowNum ?? null;\n    if (Number.isInteger(Number(rn)) && Number(rn) > 0) {\n      row_number = Number(rn);\n    } else {\n      row_number = null;\n    }\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    leadFound: row_number !== null,\n    found,\n    row_number\n  }\n}];"
      },
      "id": "fe03c088-0762-44bb-b419-8f719b302434",
      "name": "Code - Find Lead by callSid",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3536,
        1456
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date().toISOString();\nconst norm = $node[\"Code - Normalize Twilio Payload\"].json;\nconst find = $node[\"Code - Find Lead by callSid\"].json;\n\nconst found = find.found;\nconst rowNumber = find.row_number ?? find.rowNumber ?? null;\n\nconst prevTurnCount = found ? Number(found.turnCount || 0) : 0;\nconst turnCount = prevTurnCount + 1;\n\nlet hasGreeted = \"false\";\n\nif (found && found.hasGreeted === \"true\") {\n  hasGreeted = \"true\";\n} else if (prevTurnCount >= 1) {\n  hasGreeted = \"true\";\n}\n\n// Extract conversation history\nlet transcript = [];\ntry {\n  if (found && found.transcriptJson) {\n    transcript = JSON.parse(found.transcriptJson);\n  }\n} catch {}\n\nreturn [{\n  json: {\n    leadFound: find.leadFound,\n    row_number: rowNumber,\n    callSid: norm.callSid,\n    phone: norm.from,\n    speech: norm.speech,\n    createdAt: found?.createdAt || now,\n    updatedAt: now,\n    hasGreeted,\n    turnCount,\n    lastAgentReply: found?.lastAgentReply || \"\",\n    transcript: transcript,\n    name: found?.name || \"\",\n    email: found?.email || \"\",\n    topic: found?.topic || \"\",\n    urgency: found?.urgency || \"\",\n    intent: found?.intent || \"\"\n  }\n}];"
      },
      "id": "f2348b62-4391-4206-82a8-5a1df03b149b",
      "name": "Code - Prepare Call State",
      "type": "n8n-nodes-base.code",
