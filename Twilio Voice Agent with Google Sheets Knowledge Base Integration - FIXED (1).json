    {
      "parameters": {
        "jsCode": "const MAX_TURNS = 6;\nconst actionUrl = $vars.TWILIO_VOICE_WEBHOOK_URL;\n\nconst hasGreeted = $json.hasGreeted === \"true\";\nconst turnCount = Number($json.turnCount || 0);\nconst agentReply = $json.lastAgentReply || \"How can I help you today?\";\n\n// Escape XML special characters\nconst escapeXml = (s) => String(s || \"\").replace(/[<>&'\"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;',\"'\":'&apos;','\"':'&quot;'}[c]));\nconst reply = escapeXml(agentReply);\n\nlet twiml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response>`;\n\n// First greeting\nif (!hasGreeted) {\n  twiml += `\n  <Say voice=\"alice\">\n    Thanks for calling Bharat Canada Immigration.\n    ${reply}\n  </Say>\n  `;\n}\n// AI-powered conversation\nelse if (turnCount < MAX_TURNS) {\n  twiml += `\n  <Say voice=\"alice\">\n    ${reply}\n  </Say>\n  `;\n}\n// End call after max turns\nelse {\n  twiml += `\n  <Say voice=\"alice\">\n    Thank you for calling. Our team will contact you shortly.\n  </Say>\n  <Hangup/>\n  </Response>\n  `;\n  return [{ json: { twiml } }];\n}\n\n// Continue gathering\ntwiml += `\n  <Gather\n    input=\"speech\"\n    action=\"${actionUrl}\"\n    method=\"POST\"\n    timeout=\"5\"\n    speechTimeout=\"auto\"\n    actionOnEmptyResult=\"true\"\n  />\n</Response>\n`;\n\nreturn [{ json: { twiml } }];"
      },
      "id": "7a3b8ab3-7b59-4ac6-90a9-62c5303a13a1",
      "name": "Code - Build TwiML with AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1984,
        1344
      ]
    },
    {
      "parameters": {
        "jsCode": "// Generate greeting TwiML for first interaction (no speech yet)\nconst actionUrl = $vars.TWILIO_VOICE_WEBHOOK_URL;\nconst prevState = $node[\"Code - Prepare Call State\"].json;\n\nconst twiml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n  <Say voice=\"alice\">\n    Thanks for calling Bharat Canada Immigration.\n    Please tell me what you need today.\n    For example: Express Entry, PNP, Study Permit, Work Permit, Sponsorship, or Refusal.\n  </Say>\n  <Gather input=\"speech\" action=\"${actionUrl}\" method=\"POST\" timeout=\"5\" speechTimeout=\"auto\"/>\n  <Say voice=\"alice\">I didn't catch that. Please say it again.</Say>\n  <Gather input=\"speech\" action=\"${actionUrl}\" method=\"POST\" timeout=\"5\" speechTimeout=\"auto\"/>\n  <Say voice=\"alice\">No problem. We'll call you back soon.</Say>\n</Response>`;\n\nreturn [{ json: { twiml, stateForSave: prevState } }];"
      },
      "id": "1306a555-6e34-4ce8-9683-15f6037a201c",
      "name": "Code - Build Greeting TwiML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2880,
        1568
      ]
    },
